<script>
  import {
    createLearningProgressStore,
    lessonIdFromPath,
  } from '../lib/learning-progress';

  const store = createLearningProgressStore();
  const currentPath = window.location.pathname;
  const currentLessonId = lessonIdFromPath(currentPath);
  const statusClassNames = [
    'is-not-started',
    'is-in-progress',
    'is-completed',
    'is-review',
  ];
  const excludedArticlePrefixes = [
    '/about/',
    '/glossary/',
    '/paths/',
    '/resources/',
    '/review/',
    '/roadmap/',
    '/start/',
  ];

  const getArticleTitle = () =>
    document.querySelector('h1')?.textContent?.trim() || 'BioLearn';

  const canShowArticleStatus = () => {
    const path = window.location.pathname;
    if (
      path === '/' ||
      excludedArticlePrefixes.some((prefix) => path.startsWith(prefix))
    ) {
      return false;
    }

    const segments = path.split('/').filter(Boolean);
    return segments.length >= 2;
  };

  const applyBadgeState = (badge, summary) => {
    badge.textContent = summary.label;
    badge.setAttribute('aria-label', `学習状態: ${summary.label}`);
    badge.classList.remove(...statusClassNames);
    badge.classList.add(`is-${summary.status}`);
  };

  const ensureLinkBadge = (link) => {
    const parent = link.closest('li, td, .biolearn-home-card');
    if (!parent) return undefined;

    const existing = parent.querySelector(
      `:scope > [data-biolearn-progress-badge], :scope [data-biolearn-generated-badge]`,
    );
    if (existing) return existing;

    const badge = document.createElement('span');
    badge.className = 'biolearn-status-badge is-not-started';
    badge.dataset.biolearnGeneratedBadge = '';
    badge.dataset.biolearnProgressBadge = '';
    badge.textContent = '未学習';

    if (link.classList.contains('biolearn-home-card')) {
      link.insertBefore(badge, link.firstChild);
    } else {
      link.insertAdjacentElement('afterend', badge);
    }

    return badge;
  };

  const updateArticleListBadges = () => {
    document
      .querySelectorAll('[data-biolearn-article-item]')
      .forEach((item) => {
        const path = item.dataset.lessonPath;
        const badge = item.querySelector('[data-biolearn-progress-badge]');
        if (!path || !badge) return;
        applyBadgeState(badge, store.getLessonSummary(path));
      });
  };

  const updatePathLinkBadges = () => {
    if (!window.location.pathname.startsWith('/paths/')) return;

    document
      .querySelectorAll(
        '.sl-markdown-content ol a[href^="/"], .sl-markdown-content table a[href^="/"], .biolearn-home-card[href^="/"]',
      )
      .forEach((link) => {
        const href = link.getAttribute('href');
        if (
          !href ||
          href.startsWith('/paths/') ||
          href.startsWith('/glossary/')
        )
          return;

        const badge = ensureLinkBadge(link);
        if (!badge) return;
        applyBadgeState(badge, store.getLessonSummary(href));
      });
  };

  const createArticleStatusPanel = () => {
    if (!canShowArticleStatus()) return undefined;

    const title = document.querySelector('h1');
    if (!title || document.querySelector('[data-biolearn-article-status]')) {
      return document.querySelector('[data-biolearn-article-status]');
    }

    const panel = document.createElement('section');
    panel.className = 'biolearn-article-status';
    panel.dataset.biolearnArticleStatus = '';

    const badge = document.createElement('span');
    badge.className = 'biolearn-status-badge is-not-started';
    badge.dataset.biolearnProgressBadge = '';
    badge.textContent = '未学習';

    const detail = document.createElement('p');
    detail.dataset.biolearnArticleStatusDetail = '';
    detail.textContent = 'まだ学習履歴はありません。';

    const actions = document.createElement('div');
    actions.className = 'biolearn-article-status-actions';

    const completeButton = document.createElement('button');
    completeButton.type = 'button';
    completeButton.dataset.biolearnMarkComplete = '';
    completeButton.textContent = '学習済みにする';
    completeButton.addEventListener('click', () => {
      store.markLessonCompleted({
        lessonId: currentLessonId,
        path: currentPath,
        title: getArticleTitle(),
      });
      renderProgress();
    });

    actions.append(completeButton);
    panel.append(badge, detail, actions);
    title.insertAdjacentElement('afterend', panel);

    return panel;
  };

  const updateArticleStatus = () => {
    const panel = createArticleStatusPanel();
    if (!panel) return;

    const summary = store.getLessonSummary(currentPath);
    const badge = panel.querySelector('[data-biolearn-progress-badge]');
    const detail = panel.querySelector('[data-biolearn-article-status-detail]');
    const button = panel.querySelector('[data-biolearn-mark-complete]');
    if (badge) applyBadgeState(badge, summary);
    if (detail) detail.textContent = summary.detail;
    if (button) {
      button.textContent =
        summary.status === 'completed' || summary.status === 'review'
          ? '学習済みを更新'
          : '学習済みにする';
    }
  };

  const renderProgress = () => {
    updateArticleListBadges();
    updatePathLinkBadges();
    updateArticleStatus();
  };

  document.addEventListener('DOMContentLoaded', renderProgress);
  window.addEventListener('biolearn-progress-updated', renderProgress);
  renderProgress();
</script>
