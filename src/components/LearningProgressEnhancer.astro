<script>
  import {
    createLearningProgressStore,
    lessonIdFromPath,
  } from '../lib/learning-progress';

  const store = createLearningProgressStore();
  const currentPath = window.location.pathname;
  const currentLessonId = lessonIdFromPath(currentPath);
  const statusClassNames = [
    'is-not-started',
    'is-in-progress',
    'is-completed',
    'is-review',
  ];
  const excludedArticlePrefixes = [
    '/about/',
    '/glossary/',
    '/paths/',
    '/resources/',
    '/review/',
    '/roadmap/',
    '/start/',
  ];

  const getArticleTitle = () =>
    document.querySelector('h1')?.textContent?.trim() || 'BioLearn';

  const canShowArticleStatus = () => {
    const path = window.location.pathname;
    if (
      path === '/' ||
      excludedArticlePrefixes.some((prefix) => path.startsWith(prefix))
    ) {
      return false;
    }

    const segments = path.split('/').filter(Boolean);
    return segments.length >= 2;
  };

  const applyBadgeState = (badge, summary) => {
    badge.textContent = summary.label;
    badge.setAttribute('aria-label', `学習状態: ${summary.label}`);
    badge.classList.remove(...statusClassNames);
    badge.classList.add(`is-${summary.status}`);
  };

  const canTrackPath = (href) =>
    href &&
    href.startsWith('/') &&
    !href.startsWith('/paths/') &&
    !href.startsWith('/glossary/');

  const getTrackedLinks = (container) =>
    Array.from(container.querySelectorAll('a[href^="/"]')).filter((link) =>
      canTrackPath(link.getAttribute('href')),
    );

  const summarizePaths = (paths) => {
    const summaries = paths.map((path) => store.getLessonSummary(path));
    const total = summaries.length;
    const reviewCount = summaries.filter(
      (summary) => summary.status === 'review',
    ).length;
    const completedCount = summaries.filter(
      (summary) => summary.status === 'completed',
    ).length;
    const startedCount = summaries.filter(
      (summary) => summary.status !== 'not-started',
    ).length;
    const completedLikeCount = reviewCount + completedCount;

    if (total === 1) return summaries[0];

    if (reviewCount > 0) {
      return {
        status: 'review',
        label: `復習あり ${completedLikeCount}/${total}`,
      };
    }

    if (completedLikeCount === total) {
      return {
        status: 'completed',
        label: `学習済 ${total}/${total}`,
      };
    }

    if (startedCount > 0) {
      return {
        status: 'in-progress',
        label: `進行中 ${startedCount}/${total}`,
      };
    }

    return {
      status: 'not-started',
      label: `未学習 0/${total}`,
    };
  };

  const ensureContainerBadge = (container) => {
    const existing = container.querySelector(
      ':scope > [data-biolearn-generated-badge]',
    );
    if (existing) return existing;

    const badge = document.createElement('span');
    badge.className =
      'biolearn-status-badge biolearn-path-status-badge is-not-started';
    badge.dataset.biolearnGeneratedBadge = '';
    badge.dataset.biolearnProgressBadge = '';
    badge.textContent = '未学習';

    container.append(badge);

    return badge;
  };

  const ensureCardBadge = (link) => {
    const existing = link.querySelector(
      ':scope > [data-biolearn-generated-badge]',
    );
    if (existing) return existing;

    const badge = document.createElement('span');
    badge.className = 'biolearn-status-badge is-not-started';
    badge.dataset.biolearnGeneratedBadge = '';
    badge.dataset.biolearnProgressBadge = '';
    badge.textContent = '未学習';
    link.insertBefore(badge, link.firstChild);

    return badge;
  };

  const ensureSectionHeadingBadge = (heading) => {
    const existing = heading.querySelector(
      ':scope > [data-biolearn-section-progress-badge]',
    );
    if (existing) return existing;

    const badge = document.createElement('span');
    badge.className =
      'biolearn-status-badge biolearn-section-status-badge is-not-started';
    badge.dataset.biolearnSectionProgressBadge = '';
    badge.dataset.biolearnProgressBadge = '';
    badge.textContent = '未学習';

    heading.append(badge);

    return badge;
  };

  const updateArticleListBadges = () => {
    document
      .querySelectorAll('[data-biolearn-article-item]')
      .forEach((item) => {
        const path = item.dataset.lessonPath;
        const badge = item.querySelector('[data-biolearn-progress-badge]');
        if (!path || !badge) return;
        applyBadgeState(badge, store.getLessonSummary(path));
      });
  };

  const updateSectionHeadingBadges = () => {
    document
      .querySelectorAll('.sl-markdown-content .sl-heading-wrapper.level-h3')
      .forEach((wrapper) => {
        const heading = wrapper.querySelector('h3');
        const articleList = wrapper.nextElementSibling;
        if (
          !heading ||
          !articleList?.classList.contains('biolearn-article-list')
        ) {
          return;
        }

        const paths = Array.from(
          articleList.querySelectorAll('[data-biolearn-article-item]'),
        )
          .map((item) => item.dataset.lessonPath)
          .filter(Boolean);
        if (paths.length === 0) return;

        const badge = ensureSectionHeadingBadge(heading);
        applyBadgeState(badge, summarizePaths(paths));
      });
  };

  const updatePathLinkBadges = () => {
    if (!window.location.pathname.startsWith('/paths/')) return;

    document
      .querySelectorAll(
        '.sl-markdown-content ol:not(.biolearn-article-list) > li, .sl-markdown-content td',
      )
      .forEach((container) => {
        if (container.matches('[data-biolearn-article-item]')) return;

        const links = getTrackedLinks(container);
        if (links.length === 0) return;

        const badge = ensureContainerBadge(container);
        applyBadgeState(
          badge,
          summarizePaths(links.map((link) => link.getAttribute('href'))),
        );
      });

    document
      .querySelectorAll('.biolearn-home-card[href^="/"]')
      .forEach((link) => {
        const href = link.getAttribute('href');
        if (!canTrackPath(href)) return;

        const badge = ensureCardBadge(link);
        applyBadgeState(badge, store.getLessonSummary(href));
      });
  };

  const createArticleStatusPanel = () => {
    if (!canShowArticleStatus()) return undefined;

    const title = document.querySelector('h1');
    if (!title || document.querySelector('[data-biolearn-article-status]')) {
      return document.querySelector('[data-biolearn-article-status]');
    }

    const panel = document.createElement('section');
    panel.className = 'biolearn-article-status';
    panel.dataset.biolearnArticleStatus = '';

    const badge = document.createElement('span');
    badge.className = 'biolearn-status-badge is-not-started';
    badge.dataset.biolearnProgressBadge = '';
    badge.textContent = '未学習';

    const detail = document.createElement('p');
    detail.dataset.biolearnArticleStatusDetail = '';
    detail.textContent = 'まだ学習履歴はありません。';

    const actions = document.createElement('div');
    actions.className = 'biolearn-article-status-actions';

    const completeButton = document.createElement('button');
    completeButton.type = 'button';
    completeButton.dataset.biolearnMarkComplete = '';
    completeButton.textContent = '学習済みにする';
    completeButton.addEventListener('click', () => {
      store.markLessonCompleted({
        lessonId: currentLessonId,
        path: currentPath,
        title: getArticleTitle(),
      });
      renderProgress();
    });

    actions.append(completeButton);
    panel.append(badge, detail, actions);
    title.insertAdjacentElement('afterend', panel);

    return panel;
  };

  const updateArticleStatus = () => {
    const panel = createArticleStatusPanel();
    if (!panel) return;

    const summary = store.getLessonSummary(currentPath);
    const badge = panel.querySelector('[data-biolearn-progress-badge]');
    const detail = panel.querySelector('[data-biolearn-article-status-detail]');
    const button = panel.querySelector('[data-biolearn-mark-complete]');
    if (badge) applyBadgeState(badge, summary);
    if (detail) detail.textContent = summary.detail;
    if (button) {
      button.textContent =
        summary.status === 'completed' || summary.status === 'review'
          ? '学習済みを更新'
          : '学習済みにする';
    }
  };

  const renderProgress = () => {
    updateArticleListBadges();
    updateSectionHeadingBadges();
    updatePathLinkBadges();
    updateArticleStatus();
  };

  document.addEventListener('DOMContentLoaded', renderProgress);
  window.addEventListener('biolearn-progress-updated', renderProgress);
  renderProgress();
</script>
