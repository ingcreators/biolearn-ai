---
import { getCollection } from 'astro:content';
import {
  learningPathRoutes,
  type LearningPathKey,
} from '../data/learningPaths';
import { glossaryTerms } from '../data/glossary';

type Part =
  | 'start'
  | 'fundamentals'
  | 'molecular-biology'
  | 'cell-biology'
  | 'genomics'
  | 'methods'
  | 'bioinformatics'
  | 'statistics'
  | 'figures'
  | 'papers'
  | 'glossary'
  | 'resources'
  | 'paths'
  | 'about';

type LearningPath =
  | 'foundations'
  | 'figure-reading'
  | 'paper-reading'
  | 'methods-statistics'
  | 'omics-analysis';

interface Props {
  part?: Part;
  learningPath?: LearningPath;
  hrefs?: string[];
  module?: string;
  groupByModule?: boolean;
  emptyMessage?: string;
}

const {
  part,
  learningPath,
  hrefs,
  module: moduleFilter,
  groupByModule = false,
  emptyMessage = '該当する記事はまだありません。',
} = Astro.props;

const partOrder: Record<Part, number> = {
  start: 10,
  fundamentals: 20,
  'molecular-biology': 30,
  'cell-biology': 40,
  genomics: 50,
  methods: 60,
  bioinformatics: 70,
  statistics: 80,
  figures: 90,
  papers: 100,
  glossary: 110,
  resources: 120,
  paths: 130,
  about: 140,
};

const partLabels: Record<Part, string> = {
  start: 'はじめに',
  fundamentals: '生命科学の基礎',
  'molecular-biology': '分子生物学',
  'cell-biology': '細胞生物学',
  genomics: 'ゲノミクス',
  methods: '実験手法',
  bioinformatics: 'バイオインフォマティクス',
  statistics: '統計・研究デザイン',
  figures: '論文Figureの読み方',
  papers: '論文読解演習',
  glossary: '用語集',
  resources: 'リソース',
  paths: 'ラーニングパス',
  about: 'About',
};

const moduleLabels: Record<string, string> = {
  orientation: '学習の入口',
  'life-science-overview': '生命科学の全体像',
  'life-hierarchy': '生命の階層をつかむ',
  'cell-basics': '細胞の基礎',
  'genetic-information': '遺伝情報の基本',
  'dna-rna-protein-basics': 'DNA・RNA・タンパク質をつかむ',
  'gene-genome-basics': '遺伝子・ゲノム・染色体をつかむ',
  'expression-variation-phenotype': '発現・変異・表現型をつなぐ',
  'research-context': '研究対象と問いを読む',
  'molecules-and-function': '分子と機能',
  'genome-basics': 'ゲノムの基礎',
  'paper-reading-foundations': '論文読解に必要な基本概念',
  'genome-visualization': 'ゲノム情報の可視化',
  'genome-map': 'ゲノムの地図を読む',
  'genomic-variation': '配列の違いを読む',
  'genomic-disease': '疾患との関係を読む',
  'genome-function': 'ゲノムの働きを読む',
  'omics-overview': 'オミクスで全体像を見る',
  'molecular-foundations': '核酸と配列の基礎',
  'molecular-building-blocks': '分子の部品',
  'information-flow': '遺伝情報の流れ',
  'gene-regulation': '発現調節のしくみ',
  'chromatin-epigenetics': 'DNAの収納とエピジェネティクス',
  'dna-maintenance': 'DNAの維持と修復',
  'protein-foundations': 'タンパク質と酵素',
  'protein-function': 'タンパク質の形と働き',
  'cell-structure': '細胞の境界と内部構造',
  'cell-transport-localization': '膜を越える移動と局在',
  'cell-signaling': '刺激を受け取るしくみ',
  'cell-state-control': '細胞周期・細胞死・品質管理',
  'cell-fate-context': '分化・がん・免疫',
  'cell-communication': '細胞間コミュニケーション',
  variation: '遺伝的変異',
  'method-design': '実験の組み立てとサンプル',
  'nucleic-acid-measurement': '核酸を増やす・測る',
  'sequencing-workflow': 'シーケンスへつなぐ',
  'protein-cell-measurement': 'タンパク質・細胞を見る',
  'gene-function-assay': '遺伝子機能を動かして確かめる',
  'method-quality-control': '実験の信頼性を確認する',
  'nucleic-acid-methods': '核酸を扱う実験手法',
  'sample-and-control': 'サンプル・対照・実験系',
  'protein-and-cell-methods': 'タンパク質・細胞を測る実験',
  'bioinfo-foundations': '解析の全体像とデータの入口',
  'sequence-preprocessing': 'シーケンスデータの形式と前処理',
  'expression-analysis': 'RNA-seq・カウント行列・発現解析',
  'single-cell-data': 'single-cellデータと品質を整える',
  'single-cell-interpretation': '細胞集団を読み解く',
  'analysis-quality': '解析結果の偏りを確認する',
  transcriptomics: 'トランスクリプトーム解析',
  'sequence-data': 'シーケンスデータ',
  'single-cell-analysis': 'single-cell解析',
  'statistics-data-basics': 'データの種類と分布を読む',
  'statistics-uncertainty': 'ばらつきと不確かさを読む',
  'statistics-design': '比較・反復の設計を読む',
  'statistics-inference': '差の大きさと確からしさを読む',
  'statistics-critical-reading': '関係・偏り・限界を読む',
  'statistics-basics': '統計の基本',
  'experimental-design': '実験デザイン',
  'inference-and-interpretation': '推定・検定・解釈',
  'study-limitations': '研究の限界',
  'figure-basics': 'Figure読解の基礎',
  'quantitative-figures': '定量グラフ',
  'experimental-figures': '実験Figure',
  'bioinformatics-figures': '解析Figure',
  'advanced-quantitative-figures': '発展的な定量Figure',
  'figure-synthesis': 'Figureと主張をつなぐ',
  'paper-structure': '論文の構成を読む',
  'reading-workflow': '論文を読む手順',
  'paper-discovery': '論文を探す・選ぶ',
  'paper-walkthrough': '論文読解演習',
};

const toHref = (id: string) => {
  const pagePath = id.replace(/(^|\/)index$/, '').replace(/\/$/, '');
  return pagePath ? `/${pagePath}/` : '/';
};

const docs = await getCollection('docs');

const docByHref = new Map(docs.map((entry) => [toHref(entry.id), entry]));

const hrefTitleMap = new Map(
  docs.map((entry) => [toHref(entry.id), entry.data.title]),
);

const glossaryTermMap = new Map(
  glossaryTerms.map((term) => [term.href, term.term]),
);

const getPrerequisiteItems = (hrefs: string[] = []) =>
  hrefs.slice(0, 3).map((href) => ({
    href,
    title: hrefTitleMap.get(href) ?? href.replace(/^\/|\/$/g, ''),
  }));

const getRelatedTermItems = (terms: string[] = []) =>
  terms.slice(0, 3).map((term) => {
    const href = `/glossary/${term}/`;
    return {
      href,
      title: glossaryTermMap.get(href) ?? term,
    };
  });

const routeHrefs =
  hrefs ??
  (learningPath
    ? learningPathRoutes[learningPath as LearningPathKey]
    : undefined);

const articles = routeHrefs
  ? routeHrefs
      .map((href) => docByHref.get(href))
      .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry))
      .filter((entry) => !entry.data.draft)
  : docs
      .filter((entry) => {
        if (entry.data.draft) return false;
        if (part && entry.data.part !== part) return false;
        if (moduleFilter && entry.data.module !== moduleFilter) return false;
        if (learningPath && !entry.data.learningPaths?.includes(learningPath))
          return false;
        return Boolean(entry.data.part && entry.data.order !== undefined);
      })
      .sort((a, b) => {
        const partDiff =
          partOrder[a.data.part as Part] - partOrder[b.data.part as Part];
        if (partDiff !== 0) return partDiff;
        return (a.data.order ?? 999) - (b.data.order ?? 999);
      });

const articleGroups = articles.reduce<
  { module: string; label: string; articles: typeof articles }[]
>((groups, article) => {
  const module = article.data.module ?? 'other';
  const group = groups.find((item) => item.module === module);
  if (group) {
    group.articles.push(article);
  } else {
    groups.push({
      module,
      label: moduleLabels[module] ?? module,
      articles: [article],
    });
  }
  return groups;
}, []);
---

{
  articles.length > 0 ? (
    groupByModule ? (
      <div class="biolearn-module-list">
        {articleGroups.map((group) => (
          <section id={group.module}>
            <h3>{group.label}</h3>
            <ol class="biolearn-article-list">
              {group.articles.map((article) => (
                <li
                  data-biolearn-article-item
                  data-lesson-path={toHref(article.id)}
                  data-lesson-title={article.data.title}
                >
                  <a href={toHref(article.id)}>{article.data.title}</a>
                  <span
                    class="biolearn-status-badge is-not-started"
                    data-biolearn-progress-badge
                    aria-label="学習状態: 未学習"
                  >
                    未学習
                  </span>
                  {article.data.part ? (
                    <span class="biolearn-article-part">
                      {partLabels[article.data.part as Part]}
                    </span>
                  ) : null}
                  {article.data.description ? (
                    <p>{article.data.description}</p>
                  ) : null}
                  {article.data.prerequisites?.length ||
                  article.data.relatedTerms?.length ? (
                    <dl class="biolearn-article-meta">
                      {article.data.prerequisites?.length ? (
                        <div>
                          <dt>前提</dt>
                          <dd>
                            {getPrerequisiteItems(
                              article.data.prerequisites,
                            ).map((item) => (
                              <a href={item.href}>{item.title}</a>
                            ))}
                          </dd>
                        </div>
                      ) : null}
                      {article.data.relatedTerms?.length ? (
                        <div>
                          <dt>用語</dt>
                          <dd>
                            {getRelatedTermItems(article.data.relatedTerms).map(
                              (item) => (
                                <a href={item.href}>{item.title}</a>
                              ),
                            )}
                          </dd>
                        </div>
                      ) : null}
                    </dl>
                  ) : null}
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    ) : (
      <ol class="biolearn-article-list">
        {articles.map((article) => (
          <li
            data-biolearn-article-item
            data-lesson-path={toHref(article.id)}
            data-lesson-title={article.data.title}
          >
            <a href={toHref(article.id)}>{article.data.title}</a>
            <span
              class="biolearn-status-badge is-not-started"
              data-biolearn-progress-badge
              aria-label="学習状態: 未学習"
            >
              未学習
            </span>
            {article.data.part ? (
              <span class="biolearn-article-part">
                {partLabels[article.data.part as Part]}
              </span>
            ) : null}
            {article.data.description ? (
              <p>{article.data.description}</p>
            ) : null}
            {article.data.prerequisites?.length ||
            article.data.relatedTerms?.length ? (
              <dl class="biolearn-article-meta">
                {article.data.prerequisites?.length ? (
                  <div>
                    <dt>前提</dt>
                    <dd>
                      {getPrerequisiteItems(article.data.prerequisites).map(
                        (item) => (
                          <a href={item.href}>{item.title}</a>
                        ),
                      )}
                    </dd>
                  </div>
                ) : null}
                {article.data.relatedTerms?.length ? (
                  <div>
                    <dt>用語</dt>
                    <dd>
                      {getRelatedTermItems(article.data.relatedTerms).map(
                        (item) => (
                          <a href={item.href}>{item.title}</a>
                        ),
                      )}
                    </dd>
                  </div>
                ) : null}
              </dl>
            ) : null}
          </li>
        ))}
      </ol>
    )
  ) : (
    <p>{emptyMessage}</p>
  )
}
