---
interface Props {
  items: string[];
  title?: string;
}

const { items, title = 'この記事で学ぶこと' } = Astro.props;
---

<section
  class="biolearn-box biolearn-goals"
  aria-labelledby="learning-goals-title"
>
  <h3 id="learning-goals-title">{title}</h3>
  <ul>
    {items.map((item) => <li>{item}</li>)}
  </ul>
</section>
