---
interface Props {
  term: string;
  english?: string;
  abbreviation?: string;
}

const { term, english, abbreviation } = Astro.props;
---

<aside class="biolearn-box biolearn-term">
  <h3>
    {term}
    {english && <span> / {english}</span>}
    {abbreviation && <span>（{abbreviation}）</span>}
  </h3>
  <slot />
</aside>
