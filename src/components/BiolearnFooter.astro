---
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';
---

<footer class="sl-flex">
  <div class="meta sl-flex">
    <EditLink />
    <LastUpdated />
    <a
      class="biolearn-github-link"
      href="https://github.com/ingcreators/biolearn-ai"
      rel="noreferrer"
      target="_blank"
    >
      <Icon name="github" />
      GitHubで改善に参加する
    </a>
  </div>
  <Pagination />

  {
    config.credits && (
      <a class="kudos sl-flex" href="https://starlight.astro.build">
        <Icon name="starlight" /> {Astro.locals.t('builtWithStarlight.label')}
      </a>
    )
  }
</footer>

<style>
  @layer starlight.core {
    footer {
      flex-direction: column;
      gap: 1.5rem;
    }

    .meta {
      gap: 0.75rem 3rem;
      justify-content: space-between;
      flex-wrap: wrap;
      margin-top: 3rem;
      font-size: var(--sl-text-sm);
      color: var(--sl-color-gray-3);
    }

    .meta > :global(p:only-child) {
      margin-inline-start: auto;
    }

    .biolearn-github-link {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      color: var(--sl-color-gray-3);
      text-decoration: none;
    }

    .biolearn-github-link:hover {
      color: var(--sl-color-white);
    }

    .kudos {
      align-items: center;
      gap: 0.5em;
      margin: 1.5rem auto;
      font-size: var(--sl-text-xs);
      text-decoration: none;
      color: var(--sl-color-gray-3);
    }

    .kudos:hover {
      color: var(--sl-color-white);
    }
  }

  @layer starlight.components {
    .biolearn-github-link :global(svg) {
      width: 1em;
      height: 1em;
      flex: none;
    }

    .kudos :global(svg) {
      color: var(--sl-color-orange);
    }
  }
</style>
