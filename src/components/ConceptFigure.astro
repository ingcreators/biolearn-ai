---
type Variant = 'general' | 'molecule' | 'cell' | 'genome' | 'data';

interface Props {
  title: string;
  subtitle?: string;
  variant?: Variant;
  labels: string[];
  note?: string;
}

const { title, subtitle, variant = 'general', labels, note } = Astro.props;
const figureId = `concept-${title.replaceAll(/\s+/g, '-').toLowerCase()}`;
const positions = [
  { x: 118, y: 202 },
  { x: 280, y: 202 },
  { x: 442, y: 202 },
  { x: 604, y: 202 },
];
---

<figure class="biolearn-concept-figure" data-variant={variant} aria-labelledby={figureId}>
  <figcaption id={figureId}>
    <span>Concept Figure</span>
    <strong>{title}</strong>
    {subtitle && <small>{subtitle}</small>}
  </figcaption>

  <div class="biolearn-concept-visual" aria-hidden="true">
    <svg viewBox="0 0 720 280" role="img">
      <rect class="concept-bg" x="24" y="24" width="672" height="232" rx="16" />
      <path class="concept-link" d="M118 202 C190 138 220 138 280 202 S382 266 442 202 S544 138 604 202" />

      {variant === 'general' && (
        <g class="concept-motif">
          <circle cx="360" cy="104" r="46" />
          <circle cx="323" cy="84" r="17" />
          <circle cx="397" cy="84" r="17" />
          <circle cx="360" cy="132" r="20" />
          <path d="M323 84 L360 132 L397 84" />
          <path d="M360 58 L360 132" />
        </g>
      )}

      {variant === 'molecule' && (
        <g class="concept-motif">
          <path d="M296 58 C348 88 372 118 424 148" />
          <path d="M424 58 C372 88 348 118 296 148" />
          <path d="M318 72 L402 72" />
          <path d="M330 94 L390 94" />
          <path d="M342 116 L378 116" />
          <path d="M330 138 L390 138" />
          <circle cx="296" cy="58" r="8" />
          <circle cx="424" cy="58" r="8" />
          <circle cx="296" cy="148" r="8" />
          <circle cx="424" cy="148" r="8" />
        </g>
      )}

      {variant === 'cell' && (
        <g class="concept-motif">
          <ellipse cx="360" cy="106" rx="82" ry="56" />
          <circle cx="344" cy="102" r="24" />
          <ellipse cx="398" cy="122" rx="22" ry="10" />
          <ellipse cx="304" cy="120" rx="17" ry="8" />
          <path d="M402 78 C424 88 430 106 418 126" />
        </g>
      )}

      {variant === 'genome' && (
        <g class="concept-motif">
          <path d="M315 58 C356 96 364 110 405 148" />
          <path d="M405 58 C364 96 356 110 315 148" />
          <path d="M286 88 H434" />
          <path d="M286 118 H434" />
          <rect x="302" y="83" width="42" height="10" rx="5" />
          <rect x="376" y="113" width="50" height="10" rx="5" />
        </g>
      )}

      {variant === 'data' && (
        <g class="concept-motif">
          <rect x="288" y="70" width="58" height="48" rx="8" />
          <rect x="374" y="70" width="58" height="48" rx="8" />
          <path d="M346 94 H374" />
          <path d="M312 142 H424" />
          <path d="M316 142 V130" />
          <path d="M346 142 V122" />
          <path d="M376 142 V110" />
          <path d="M406 142 V126" />
        </g>
      )}

      {
        labels.slice(0, 4).map((label, index) => {
          const position = positions[index];
          return (
            <g class="concept-node">
              <circle cx={position.x} cy={position.y} r="26" />
              <text x={position.x} y={position.y + 5}>{index + 1}</text>
              <foreignObject x={position.x - 62} y={position.y + 34} width="124" height="42">
                <p xmlns="http://www.w3.org/1999/xhtml">{label}</p>
              </foreignObject>
            </g>
          );
        })
      }
    </svg>
  </div>

  {note && <p>{note}</p>}
</figure>
